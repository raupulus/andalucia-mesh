# ==============================================================================
# .env.example (services/bot-telegram)
# Variables de entorno específicas para el bot de Telegram.
# ==============================================================================

# Conexión a PostgreSQL (Base y rol propios)
DB_HOST=172.30.0.1
DB_PORT=5432
DB_NAME=snm_bot_telegram
DB_USER=snm_bot_telegram
DB_PASSWORD=cambiar_por_clave_segura_telegram

# Token de Bot de Telegram (Obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Socket UNIX de alertas
ALERTAS_SOCKET=/run/snm/alertas.sock
ALERTAS_SOCKET_GID=10500

# Parámetros operativos y anti-ruido
TELEGRAM_COMANDO_MAX_EDAD_S=120
TELEGRAM_BORRAR_COMANDOS_CANAL_S=60
BOT_RIESGOS_DEFECTO=medio,alto
BOT_TIPOS_DEFECTO=infraestructura
BOT_MAX_MENSAJES_MINUTO=10
BOT_MAX_MENSAJES_SEGUNDO=25
BOT_AGRUPAR_UMBRAL=5
BOT_AGRUPAR_VENTANA_S=120
BOT_DIAS_FALLO_DESACTIVAR=3
API_CACHE_S=30
API_TIMEOUT_S=5
LOG_LEVEL=INFO
RETENCION_DIAS=365
HEALTH_PORT=8080
