# ==============================================================================
# .env.example (services/chat-ws/)
#
# Plantilla de variables de entorno para el microservicio chat-ws.
# Copiar a /srv/chat-ws/.env en el servidor y configurar permisos 0640/0600.
# ==============================================================================

# Entorno y zona horaria
TZ=Europe/Madrid
LOG_LEVEL=INFO

# Broker MQTT (red mesh)
MQTT_HOST=172.30.0.1
MQTT_PORT=1884
MQTT_TOPIC_PREFIX=snm
MQTT_USER=svc-chatws
MQTT_PASSWORD=insecure_placeholder_chatws_mqtt

# Canales admitidos y canal primario
ALLOWED_CHANNELS=SFNarrow,Iberia,Andalucia,Cadiz,Huelva,Almeria,Granada,Jaen,Sevilla,Cordoba,Malaga,Ceuta,Melilla,sos
PRIMARY_CHANNEL=SFNarrow

# Servidor WebSocket público (interno contenedor :8000, host :8090)
CHAT_PUERTO=8000
CHAT_HOST=0.0.0.0

# Servidor HTTP interno de salud (/health en red mesh)
HEALTH_PORT=8080
HEALTH_HOST=0.0.0.0

# Límites e historial en memoria
CHAT_HISTORIAL=20
CHAT_MAX_CONEXIONES=2000
CHAT_MAX_POR_IP=10
CHAT_PROXIES_CONFIABLES=172.30.0.1,127.0.0.1
