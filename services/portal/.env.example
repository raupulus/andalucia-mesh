# ==============================================================================
# .env.example (services/portal/)
#
# Plantilla de configuración de entorno para el Portal Web Laravel y API REST.
# Los valores específicos de cada despliegue deben definirse en /srv/portal/.env.
# ==============================================================================

APP_NAME="Andalucía Mesh"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mesh.example.org

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=Europe/Madrid

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Base de datos principal del Portal (sesiones, usuarios, estado)
DB_CONNECTION=pgsql
DB_HOST=172.30.0.1
DB_PORT=5432
DB_DATABASE=portal
DB_USERNAME=portal
DB_PASSWORD=secret_portal_db_password

# Conexión de solo lectura a la base de Ingesta (vistas api_*)
DB_INGESTA_DRIVER=pgsql
DB_INGESTA_DATABASE=snm_ingest
DB_INGESTA_USERNAME=portal_lector_ingesta
DB_INGESTA_PASSWORD=secret_ingesta_reader_password

# Conexión de solo lectura a la base de Alertas (vistas api_alertas_*)
DB_ALERTAS_DRIVER=pgsql
DB_ALERTAS_DATABASE=snm_alerts
DB_ALERTAS_USERNAME=portal_lector_alertas
DB_ALERTAS_PASSWORD=secret_alertas_reader_password

# Almacenamiento de sesión y caché
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
CACHE_STORE=database

QUEUE_CONNECTION=database

# Comprobación de salud Mosquitto (panel de operador)
MQTT_HOST=172.30.0.1
MQTT_PORT=1884
MQTT_PANEL_USER=svc-panel
MQTT_PANEL_PASSWORD=secret_panel_mqtt_password
