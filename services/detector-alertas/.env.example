# ==============================================================================
# .env.example (services/detector-alertas/)
#
# Plantilla de variables de entorno para el microservicio detector-alertas.
# Copiar a /srv/detector-alertas/.env en el servidor y configurar permisos 0600.
# ==============================================================================

# Entorno y zona horaria
TZ=Europe/Madrid
LOG_LEVEL=INFO

# Broker MQTT (red mesh)
MQTT_HOST=mosquitto
MQTT_PORT=1884
MQTT_TOPIC_PREFIX=snm
MQTT_USER=svc-detector
MQTT_PASSWORD=insecure_placeholder_detector_mqtt
MQTT_CLIENT_ID=detector-alertas

# Base de datos PostgreSQL / TimescaleDB (host nativo 172.30.0.1)
DB_HOST=172.30.0.1
DB_PORT=5432
DB_NAME=snm_detector
DB_USER=snm_detector
DB_PASSWORD=insecure_placeholder_detector_db

# Socket UNIX de salida NDJSON
ALERTAS_SOCKET=/run/snm/alertas.sock
ALERTAS_SOCKET_GID=10500

# Archivos de configuración de clasificación y reglas
CLASIFICACION_PATH=/config/clasificacion.yaml
REGLAS_PATH=/config/reglas.yaml

# Servidor HTTP interno de salud y métricas
HEALTH_PORT=8080

# Parámetros operativos y de memoria
COLA_MAX=10000
SNAPSHOT_S=60
RETENCION_DIAS=365

# Protocolo del socket UNIX
REENVIO_MAX_H=24
LATIDO_S=30
CLIENTE_MAX_PENDIENTES=1000
SALUDO_TIMEOUT_S=10.0

# Roles de infraestructura
INFRA_ROLES=ROUTER,ROUTER_LATE,REPEATER
SATURACION_PESO_ROUTERS=0.6
SATURACION_PESO_CLIENTES=0.4
