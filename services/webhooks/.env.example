# ==============================================================================
# .env.example (services/webhooks)
# Variables de entorno específicas para el microservicio de Webhooks.
# ==============================================================================

# Conexión a PostgreSQL (Base y rol propios)
DB_HOST=172.30.0.1
DB_PORT=5432
DB_NAME=snm_webhooks
DB_USER=snm_webhooks
DB_PASSWORD=cambiar_por_clave_segura_webhooks

# Socket UNIX de alertas
ALERTAS_SOCKET=/run/snm/alertas.sock
ALERTAS_SOCKET_GID=10500

# Archivo de configuración de destinos
WEBHOOKS_CONFIG_HOST=/srv/webhooks/webhooks.yaml
WEBHOOKS_ARCHIVO=/app/config/webhooks.yaml
WEBHOOKS_TIMEOUT_S=10
WEBHOOKS_CONCURRENCIA=10
WEBHOOKS_FALLOS_DESACTIVAR=20
WEBHOOKS_IPS_BLOQUEADAS=144.91.93.7,2001:db8::/64

# Configuración operativa
LOG_LEVEL=INFO
RETENCION_DIAS=365
HEALTH_PORT=8080
INTERNAL_API_SECRET=cambiar_por_secreto_interno_compartido_entre_portal_y_webhooks

# Secretos por destino registrado (formato: WEBHOOK_<NOMBRE>_SECRETO >= 32 chars)
WEBHOOK_RADIO_CLUB_CADIZ_SECRETO=secreto_ejemplo_muy_largo_de_mas_de_32_caracteres_1
WEBHOOK_MONITOR_NODO_PROPIO_SECRETO=secreto_ejemplo_muy_largo_de_mas_de_32_caracteres_2
