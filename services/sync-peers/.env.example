# ==============================================================================
# .env.example (services/sync-peers/)
#
# Variables específicas para el sincronizador de peers.
# Copiar a /srv/sync-peers/.env con permisos 0600 en el servidor.
# ==============================================================================

# Credenciales MQTT para el servicio (generadas con mqtt-users.sh service svc-potato)
MQTT_USER=svc-potato
MQTT_PASSWORD=clave_alfanumerica_24_caracteres_svc_potato

# Credenciales de base de datos PostgreSQL nativa (generadas con set-role-password.sh peersync)
DB_HOST=172.30.0.1
DB_PORT=5432
DB_NAME=peersync
DB_USER=peersync
DB_PASSWORD=clave_alfanumerica_32_caracteres_peersync

# Token de autenticación de la API interna de PotatoMesh local
POTATOMESH_URL=http://potatomesh:41447
POTATOMESH_API_TOKEN=token_secreto_32_caracteres_potatomesh

# Fichero de configuración de instancias vecinas
PEERS_ARCHIVO=/app/peers.json

# Ajustes de temporización y paginación
CICLO_MENSAJES_S=60
PAGINAS_MAX=20
LOG_LEVEL=INFO
