# ==============================================================================
# .env.example (services/bot-discord)
# Variables de entorno específicas para el bot de Discord.
# ==============================================================================

# Conexión a PostgreSQL (Base y rol propios)
DB_HOST=172.30.0.1
DB_PORT=5432
DB_NAME=snm_bot_discord
DB_USER=snm_bot_discord
DB_PASSWORD=cambiar_por_clave_segura_discord

# Token y App ID de Discord (Portal Developer)
DISCORD_BOT_TOKEN=cambiar_por_token_discord
DISCORD_APP_ID=123456789012345678

# Socket UNIX de alertas
ALERTAS_SOCKET=/run/snm/alertas.sock
ALERTAS_SOCKET_GID=10500

# Parámetros operativos y anti-ruido
BOT_RIESGOS_DEFECTO=alto
BOT_TIPOS_DEFECTO=infraestructura
BOT_MAX_MENSAJES_MINUTO=10
BOT_MAX_MENSAJES_SEGUNDO=25
BOT_AGRUPAR_UMBRAL=5
BOT_AGRUPAR_VENTANA_S=120
BOT_DIAS_FALLO_DESACTIVAR=3
API_CACHE_S=30
API_TIMEOUT_S=5
LOG_LEVEL=INFO
RETENCION_DIAS=365
HEALTH_PORT=8080
