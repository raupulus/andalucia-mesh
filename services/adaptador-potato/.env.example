# ==============================================================================
# .env.example (services/adaptador-potato/)
#
# Variables específicas para el adaptador MQTT → PotatoMesh.
# Copiar a /srv/adaptador-potato/.env con permisos 0600 en el servidor.
# ==============================================================================

# Credenciales MQTT para el servicio (generadas con mqtt-users.sh service svc-potato)
MQTT_USER=svc-potato
MQTT_PASSWORD=clave_alfanumerica_24_caracteres_svc_potato

# Token de autenticación de la API interna de PotatoMesh
# (debe coincidir exactamente con POTATOMESH_API_TOKEN configurado en /srv/potatomesh/.env)
POTATOMESH_API_TOKEN=token_secreto_32_caracteres_potatomesh

# URL base interna de PotatoMesh en la red Docker 'mesh'
POTATOMESH_URL=http://potatomesh:41447

# Ajustes de cola y lotes
COLA_MAX=10000
LOTE_MAX=100
LOTE_SEGUNDOS=1.0
DEDUP_MINUTOS=15
LOG_LEVEL=INFO
