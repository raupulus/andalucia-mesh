# ==============================================================================
# .env.example (services/ingesta/)
#
# Variables específicas para el servicio de ingesta (Andalucía Mesh).
# Copiar a /srv/ingesta/.env con permisos 0600 en el servidor.
# ==============================================================================

# Credenciales de Mosquitto (usuario svc-ingest)
MQTT_USER=svc-ingest
MQTT_PASSWORD=clave_alfanumerica_24_caracteres_svc_ingest

# Conexión a PostgreSQL 17 + TimescaleDB (usuario snm_ingest)
DB_HOST=172.30.0.1
DB_PORT=5432
DB_NAME=snm_ingest
DB_USER=snm_ingest
DB_PASSWORD=clave_alfanumerica_24_caracteres_db_ingest

# Canales autorizados y parámetros de radio LoRa
ALLOWED_CHANNELS=SFNarrow,Iberia,Andalucia,Cadiz,Huelva,Almeria,Granada,Jaen,Sevilla,Cordoba,Malaga,Ceuta,Melilla,sos
PRIMARY_CHANNEL=SFNarrow
CHANNEL_KEY_DEFAULT=AQ==
INFRA_ROLES=ROUTER,ROUTER_LATE,REPEATER
LORA_BANDWIDTH=62.5
LORA_SPREAD_FACTOR=7
LORA_CODING_RATE=5
INGESTA_LORA_PREAMBULO=16

# Ventanas de acumulación y deduplicación
INGESTA_VENTANA_PUBLICACION_S=2.0
INGESTA_VENTANA_DEDUP_MIN=15

# Geometría y límites de posición
INGESTA_POLIGONOS=/app/polygons/provincias-andalucia.geojson
INGESTA_PRECISION_MAX_M=12000.0
INGESTA_MARGEN_MIN_M=500.0
INGESTA_ENLACE_PRECISION_MAX_M=3000.0
INGESTA_ENLACE_MAX_KM=300.0

# Lotes de persistencia e inserción en base de datos
INGESTA_LOTE_FILAS=500
INGESTA_LOTE_MS=1000
INGESTA_BUFFER_MAX_FILAS=100000

# Salud y registro
HEALTH_PORT=8080
LOG_LEVEL=INFO
