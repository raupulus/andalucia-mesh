# ==============================================================================
# Plantilla de configuración de vigilancia del host
# Ruta de producción en servidor: /etc/snm/vigilancia.env (permisos 0600)
# ==============================================================================

# Umbrales de advertencia en recursos del host
VIG_DISCO_PCT=70
VIG_RAM_PCT=80
VIG_CARGA5=2.5
VIG_CERT_DIAS=14

# Notificaciones opcionales vía bot privado de Telegram para el operador
# (Dejar vacío o sin configurar para desactivar avisos externos)
AVISO_TELEGRAM_TOKEN=
AVISO_TELEGRAM_CHAT_ID=

# Dominio base de los certificados a comprobar
VIG_DOMAIN=mesh.example.org
