# ==============================================================================
# .env.example (infrastructure/common/.env.example)
#
# Plantilla maestra de variables de entorno comunes para Andalucía Mesh.
# Copiar este archivo a common/.env en el servidor (/var/www/storage/sur-nodos-en-mallas/common/.env)
# y ajustar los valores para la instancia.
# ==============================================================================

# --- IDENTIDAD Y DOMINIOS PÚBLICOS ---
PROJECT_NAME="Andalucía Mesh"
PROJECT_DOMAIN="mesh.example.org"
PROJECT_CONTACT="public@raupulus.dev"

# Subdominio independiente para MeshView (regla TR-01: evita conflictos de proxy naranja en Cloudflare)
# Si PROJECT_DOMAIN es 'mesh.midominio.es', MESHVIEW_DOMAIN puede ser 'meshview.midominio.es'
MESHVIEW_DOMAIN="meshview.example.org"

# --- ENTORNO Y ZONA HORARIA ---
APP_ENV="production"
APP_DEBUG="false"
TZ="Europe/Madrid"

# --- PARÁMETROS DE RADIO Y MALLA (MESHTASTIC) ---
# Canales permitidos y decodificados por el sistema
ALLOWED_CHANNELS="SFNarrow,Iberia,Andalucia,Cadiz,Huelva,Almeria,Granada,Jaen,Sevilla,Cordoba,Malaga,Ceuta,Melilla,sos"
PRIMARY_CHANNEL="SFNarrow"
MESHTASTIC_PRESET="#SFNarrow"
MESHTASTIC_FREQ="868MHz"

# --- GEOGRAFÍA Y MAPAS ---
# Coordenadas centrales del mapa (Andalucía) y nivel de zoom inicial
MAP_CENTER="36.8,-5.5"
MAP_ZOOM="8"

# --- CONEXIÓN DE BASE DE DATOS (POSTGRESQL 17 + TIMESCALEDB EN HOST) ---
# Los contenedores conectan al host a través de la puerta de enlace de la red Docker 'mesh'
DB_HOST="172.30.0.1"
DB_PORT="5432"

# --- CONEXIÓN AL BROKER MQTT (MOSQUITTO NATIVO EN HOST) ---
# Los contenedores conectan al listener interno en la puerta de enlace 'mesh'
MQTT_HOST="172.30.0.1"
MQTT_PORT="1884"

# --- PUERTOS LOCALES DEL HOST (BIND A 127.0.0.1) ---
# Ningún servicio debe exponerse a 0.0.0.0
PORT_PORTAL=8100
PORT_CHATWS=8090
PORT_POTATOMESH=41447
PORT_MESHVIEW=8081

# --- RED DOCKER Y ALMACENAMIENTO ---
DOCKER_NETWORK_NAME="mesh"
DOCKER_GATEWAY_IP="172.30.0.1"
STORAGE_BASE_DIR="/var/www/storage/sur-nodos-en-mallas"

# --- SECRETOS INTERNOS INTER-SERVICIO ---
# Token para comunicación interna entre Portal y microservicios (ej. webhooks)
INTERNAL_API_SECRET="cambiar_por_secreto_interno_compartido_entre_portal_y_webhooks"

