# ==============================================================================
# .env.example (integrations/meshconfig/)
#
# Variables específicas para el configurador web de dispositivos Meshtastic.
# El puerto se vincula exclusivamente a loopback (127.0.0.1) para seguridad.
# ==============================================================================

# Puerto local en el anfitrión (reverse proxy Nginx proxifica hacia este puerto)
MESHCONFIG_PORT=8420

# Dominio público opcional si se despliega como subdominio dedicado
CONFIG_DOMAIN=config.mesh.example.org
