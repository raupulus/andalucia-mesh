# ==============================================================================
# .env.example (integrations/potatomesh/)
#
# Variables específicas para el despliegue de PotatoMesh.
# Copiar a /srv/potatomesh/.env con permisos 0600 en el servidor.
# ==============================================================================

# Token secreto compartido para inyección vía API (adaptador-potato y sync-peers)
API_TOKEN=genera_un_token_secreto_alfanumerico_robusto_64_caracteres

# Dominio canónico de la instancia (previene envenenamiento de caché HTTP)
INSTANCE_DOMAIN=https://potato.mesh.desdechipiona.es

# Nombre del proyecto mostrado en la interfaz
SITE_NAME="Andalucía Mesh"

# Preset de radio y frecuencia
MESHTASTIC_PRESET=#SFNarrow
MESHTASTIC_FREQ=868MHz

# Encuadre geográfico inicial y límite de cobertura (centro geográfico de Andalucía: Lucena/Puente Genil)
# Con MAP_CENTER=37.45,-4.60 y MAX_DISTANCE=270 se cubre el 100% de Andalucía (de Ayamonte 261 km a Pulpí 262 km)
# descartando nodos y trazas exteriores (Madrid, Albacete, Portugal).
MAP_CENTER=37.45,-4.60
MAP_ZOOM=8
MAX_DISTANCE=270

# Concurrencia para clientes SSE (Server-Sent Events)
MIN_THREADS=32
MAX_THREADS=500

# Habilitar eventos en tiempo real
EVENTS=1

# Desactivar federación directa para evitar bucles con terceros
FEDERATION=0

# Canales públicos visibles e indexables
PRIVATE=0

# Enlace de contacto público oficial
CONTACT_LINK=mailto:public@raupulus.dev

# Ruta de páginas personalizadas dentro del contenedor
PAGES_DIR=/app/pages

# Ruta local de base SQLite para el script de limpieza diaria
POTATOMESH_SQLITE=/srv/potatomesh/datos/mesh.db

# Indicador visual de retención mostrado en la barra de navegación (navbar)
RETENTION_BADGE="Nodos: 15d · Trazas: 5d"
